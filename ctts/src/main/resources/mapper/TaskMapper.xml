<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gzu.ctts.mapper.TaskMapper">

    <select id="getById" resultType="com.gzu.ctts.entity.Task">
        SELECT id, project_id, title, description, deadline, total_score, `status`, create_time, update_time FROM task
        WHERE id = #{id}
    </select>



    <select id="selectByTitleOrDescription" resultType="com.gzu.ctts.entity.Task">
        SELECT * FROM task
        <where>
            1=1
            <if test="title != null">
                AND title LIKE CONCAT('%', #{title}, '%')
            </if>
            <if test="description != null">
                AND description LIKE CONCAT('%', #{description}, '%')
            </if>
        </where>
    </select>

    <select id="selectByPidAndStatus" resultType="com.gzu.ctts.entity.Task">
        SELECT * FROM task
        <where>
            <if test="projectId != null">
                AND project_id = #{projectId}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectByStatusList" resultType="com.gzu.ctts.entity.Task">
        SELECT * FROM task
        <where>
            <if test="statusList != null and statusList.size > 0">
                AND status IN
                <foreach collection="statusList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>
</mapper>